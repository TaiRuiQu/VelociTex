+    }
+    private static bool IsMathCharacter(char value)=>char.IsAsciiLetterOrDigit(value)||value is ' ' or '\t' or '\\' or '{' or '}' or '(' or ')' or '[' or ']' or '^' or '_' or '=' or '+' or '-' or '*' or '/' or '<' or '>' or '|' or '!' or '.' or ',' or ';' or ':' or '%' or '$' or '\'' or '．' or '、' or '）' or >= '\u0370' and <= '\u03ff' or >= '\u2200' and <= '\u22ff';
