<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>false</IsAotCompatible>
    <DownstreamDocumentsAssembly Condition="'$(DownstreamDocumentsAssembly)' == ''">$(MSBuildThisFileDirectory)..\..\..\oh-my-study\src\OhMyStudy.Documents\bin\x64\Release\net10.0\OhMyStudy.Documents.dll</DownstreamDocumentsAssembly>
  </PropertyGroup>
  <ItemGroup>
    <!-- Development measurement only: no downstream project reference/build/mutation. -->
    <Reference Include="OhMyStudy.Documents">
      <HintPath>$(DownstreamDocumentsAssembly)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
