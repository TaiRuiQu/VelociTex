<Project>
  <PropertyGroup>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsAotCompatible>true</IsAotCompatible>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
    <AnalysisLevel>latest</AnalysisLevel>
    <NuGetAudit>true</NuGetAudit>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2057;IL2060;IL2070;IL2072;IL2075;IL2091;IL2104;IL3050;IL3053</WarningsAsErrors>
    <!-- Use the local ILLink shim only when a checkout actually provides it. The
         shim is an untracked, machine-specific workaround; referencing it
         unconditionally breaks clean checkouts and CI AOT publishes. -->
    <ILLinkTargetsPath Condition="'$(PublishAot)' == 'true' and '$(VelociTexDisableIlcTaskHostWorkaround)' != 'true' and Exists('$(MSBuildThisFileDirectory)build/VelociTex.ILLink.targets')">$(MSBuildThisFileDirectory)build/VelociTex.ILLink.targets</ILLinkTargetsPath>
  </PropertyGroup>
</Project>
