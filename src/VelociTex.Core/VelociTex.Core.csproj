<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../PackageMetadata.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true'">packages.aot.lock.json</NuGetLockFilePath>
    <Description>Compact single-formula TeX parsing and layout using locked KaTeX 0.19.0 rules.</Description>
