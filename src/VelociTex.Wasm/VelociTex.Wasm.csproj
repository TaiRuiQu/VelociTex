<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <WasmEnableHotReload>false</WasmEnableHotReload>
    <WasmEnableThreads>false</WasmEnableThreads>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- SDK WebAssembly/ILLink packages are signed per platform; their NuGet
         content hashes differ between the Windows and Linux SDK distributions.
         A cross-platform lock file would reject one of them with NU1403. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <RunAOTCompilation Condition="'$(RunAOTCompilation)' == ''">true</RunAOTCompilation>
    <WasmStripILAfterAOT>true</WasmStripILAfterAOT>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../VelociTex.Core/VelociTex.Core.csproj" />
    <ProjectReference Include="../VelociTex.Rendering.Svg/VelociTex.Rendering.Svg.csproj" />
  </ItemGroup>
  <!-- The C++ core is linked into the .NET runtime's Wasm module instead of being
       loaded as a DLL. The archive file name must match the [LibraryImport] module
       name so the SDK records these natives in its P/Invoke table. -->
  <ItemGroup>
    <NativeFileReference Include="$(MSBuildThisFileDirectory)..\..\artifacts\wasm\native\VelociTex.Core.Native.a"
                         Condition="Exists('$(MSBuildThisFileDirectory)..\..\artifacts\wasm\native\VelociTex.Core.Native.a')" />
  </ItemGroup>
  <!-- The browser SDK defaults Mono AOT to `no-opt`. Keep LLVM AOT enabled but
       let it optimize the generated bitcode; this is the compile-time/quality
       tradeoff required by the performance target. -->
  <Target Name="EnableMonoAotOptimizations" BeforeTargets="_WasmAotCompileApp">
    <ItemGroup>
      <MonoAOTCompilerDefaultAotArguments Remove="no-opt" />
    </ItemGroup>
  </Target>
  <Target Name="CopyRuntimeLicenses" AfterTargets="Publish">
    <ItemGroup>
      <_LicenseRuntimePack Include="@(ResolvedRuntimePack)" Condition="'%(ResolvedRuntimePack.Identity)' == 'Microsoft.NETCore.App.Runtime.Mono.browser-wasm'" />
    </ItemGroup>
    <PropertyGroup>
      <_LicenseRuntimePackDir>@(_LicenseRuntimePack->'%(PackageDirectory)')</_LicenseRuntimePackDir>
    </PropertyGroup>
    <Error Condition="!Exists('$(_LicenseRuntimePackDir)/LICENSE.TXT')" Text="The .NET runtime license is missing." />
    <Copy SourceFiles="$(_LicenseRuntimePackDir)/LICENSE.TXT" DestinationFiles="$(PublishDir)wwwroot/_framework/LICENSE.dotnet.txt" />
    <Copy SourceFiles="$(_LicenseRuntimePackDir)/THIRD-PARTY-NOTICES.TXT" DestinationFiles="$(PublishDir)wwwroot/_framework/THIRD-PARTY-NOTICES.dotnet.txt" />
  </Target>
</Project>
