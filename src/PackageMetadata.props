<Project>
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Version>0.2.0-preview.1</Version>
    <PackageVersion>$(Version)</PackageVersion>
    <Authors>VelociTex contributors</Authors>
    <PackageLicenseExpression>MIT AND OFL-1.1</PackageLicenseExpression>
    <PackageReadmeFile>PACKAGE-README.md</PackageReadmeFile>
    <PackageTags>math;TeX;NativeAOT;KaTeX;typesetting</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Description>Local preview of compact single-formula typesetting based on locked KaTeX 0.19.0. Compatibility and old-hardware acceptance remain in progress. Code is MIT; bundled fonts are OFL-1.1 with Reserved Font Names.</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../PACKAGE-README.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../licenses/*" Pack="true" PackagePath="licenses/" />
    <None Include="$(MSBuildThisFileDirectory)../docs/reference/katex-0.19.0.lock.json" Pack="true" PackagePath="reference/" />
    <None Include="$(MSBuildThisFileDirectory)../docs/reference/katex-0.19.0.files.json" Pack="true" PackagePath="reference/" />
    <None Include="$(MSBuildThisFileDirectory)../docs/reference/font-generation-0.19.0.json" Pack="true" PackagePath="reference/" />
    <None Include="$(MSBuildThisFileDirectory)../Directory.Packages.props" Pack="true" PackagePath="reference/" />
    <None Include="$(MSBuildThisFileDirectory)../global.json" Pack="true" PackagePath="reference/" />
    <None Include="$(MSBuildThisFileDirectory)../docs/package-contract.md" Pack="true" PackagePath="docs/" />
  </ItemGroup>
</Project>
